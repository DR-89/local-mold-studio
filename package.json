  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-offline-shell.mjs",
    "start": "vinext start",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:benchmark": "playwright test --config playwright.benchmark.config.ts",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.0",
    "fflate": "^0.8.2",
    "manifold-3d": "^3.5.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
